# 채널 레지스트리. channels.toml 로 복사해서 쓰세요.
#
# 계정 정보는 여기에 적지 않습니다. 로그인 세션은 채널별 브라우저 프로필
# (~/Library/Application Support/tiktok-uploader/profiles/<채널명>) 에 남습니다.
#
# 채널명에 한글이나 공백이 들어가면 TOML 규칙상 따옴표로 감싸야 합니다.

[channels."보수시민"]
default_privacy = "public"   # public | friends | private
allow_comment = true
allow_duet = true
allow_stitch = true

[channels."진보시민"]
default_privacy = "public"
allow_comment = true
allow_duet = true
allow_stitch = true
